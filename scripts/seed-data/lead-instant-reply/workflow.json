      "id": "b1a2c3d4-0001-4a01-9001-webhooktrigger",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -160,
        320
      ],
      "webhookId": "b1a2c3d4-0001-4a01-9001-webhooktrigger"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f0000001-0000-4000-8000-000000000001",
              "name": "name",
              "value": "={{ ($json.body?.name ?? $json.query?.name ?? $json.name ?? 'there').toString().trim() || 'there' }}",
              "type": "string"
            },
            {
              "id": "f0000001-0000-4000-8000-000000000002",
              "name": "phone",
              "value": "={{ (() => { const raw = ($json.body?.phone ?? $json.query?.phone ?? $json.phone ?? '').toString().trim(); if (!raw) return ''; if (raw.startsWith('+')) return '+' + raw.slice(1).replace(/\\D/g, ''); let d = raw.replace(/\\D/g, ''); if (d.startsWith('00')) return '+' + d.slice(2); const defaultCountryCode = '1'; return '+' + defaultCountryCode + d; })() }}",
              "type": "string"
            },
            {
              "id": "f0000001-0000-4000-8000-000000000003",
              "name": "email",
              "value": "={{ ($json.body?.email ?? $json.query?.email ?? $json.email ?? '').toString().trim() }}",
              "type": "string"
            },
            {
              "id": "f0000001-0000-4000-8000-000000000004",
              "name": "message",
              "value": "={{ ($json.body?.message ?? $json.query?.message ?? $json.message ?? '').toString().trim() || '(no message provided)' }}",
              "type": "string"
            },
            {
              "id": "f0000001-0000-4000-8000-000000000005",
              "name": "source",
              "value": "={{ ($json.body?.source ?? $json.query?.source ?? $json.source ?? '').toString().trim() || 'Website form' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1a2c3d4-0002-4a02-9002-formatleadnode",
      "name": "Format Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        80,
        320
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Time": "={{ $now.toISO() }}",
            "Name": "={{ $('Format Lead').item.json.name }}",
            "Phone": "={{ $('Format Lead').item.json.phone }}",
            "Email": "={{ $('Format Lead').item.json.email }}",
            "Message": "={{ $('Format Lead').item.json.message }}",
            "Source": "={{ $('Format Lead').item.json.source }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "Time",
              "displayName": "Time",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "Name",
