        "emailType": "text",
        "message": "=You missed a call — text-back already sent. Call them back to close the loop.\n\nCaller:  {{ $('Format Call').item.json.caller }}\nStatus:  {{ $('Format Call').item.json.status }}\nCalled:  {{ $('Format Call').item.json.calledNumber }}\nTime:    {{ $now.toISO() }}",
        "options": {}
